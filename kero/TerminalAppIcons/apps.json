    },
    {
      "label": "pnpm",
      "match": ["pnpm"],
      "material": "pnpm"
    },
    {
      "label": "Yarn",
      "match": ["yarn", "yarn.js"],
      "icon": "bxl-yarn.svg"
    },
  
    {
      "label": "Bun",
      "match": ["bun"],
      "material": "bun"
    },
    {
      "label": "Deno",
      "match": ["deno"],
      "material": "deno"
    },
    {
      "label": "Python",
      "match": ["python", "python3"],
      "matchPrefix": ["python3."],
      "material": "python"
    },
    {
      "label": "Docker",
      "match": ["docker", "docker-compose", "com.docker.cli"],
      "material": "docker"
    },
    {
      "label": "Git",
      "match": ["git"],
      "material": "git"
    },
    {
      "label": "GitHub CLI",
      "match": ["gh"],
      "icon": "bxl-github.svg"
    },
    {
      "label": "GitLab",
      "match": ["gitlab"],
      "material": "gitlab"
    },
    {
      "label": "Vim / Neovim",
      "match": ["vim", "nvim", "nvim-qt", "vimdiff"],
      "material": "vim"
    },
    {
      "label": "Go",
      "match": ["go", "gopls"],
      "material": "go"
    },
    {
      "label": "Rust",
      "match": ["cargo", "rustc", "rustup"],
      "material": "rust"
    },
    {
      "label": "Swift",
      "match": ["swift", "swiftc"],
      "material": "swift"
    },
    {
      "label": "Java",
      "match": ["java", "javac"],
      "material": "java"
    },
    {
      "label": "PHP",
      "match": ["php"],
      "material": "php"
    },
    {
      "label": "Ruby",
      "match": ["ruby", "irb", "bundle", "bundler"],
      "material": "ruby"
    },
    {
      "label": "Vite",
      "match": ["vite"],
      "material": "vite"
    },
    {
      "label": "Vitest",
      "match": ["vitest"],
      "matchPrefix": ["vitest-"],
      "icon": "app-vitest.svg"
    },
    {
      "label": "Rspack",
      "match": ["rspack", "@rspack"],
      "matchPrefix": ["rspack-", "@rspack"],
      "icon": "rspack.svg"
    },
    {
      "label": "Rsbuild",
      "match": ["rsbuild", "@rsbuild"],
      "matchPrefix": ["rsbuild-", "@rsbuild"],
      "icon": "rsbuild.svg"
    },
    {
      "label": "Rslib",
      "match": ["rslib", "@rslib"],
      "matchPrefix": ["rslib-", "@rslib"],
      "icon": "rslib.svg"
    },
    {
      "label": "Rstest",
      "match": ["rstest", "@rstest"],
      "matchPrefix": ["rstest-", "@rstest"],
      "icon": "rstest.svg"
    },
    {
      "label": "Webpack",
      "match": ["webpack"],
      "icon": "webpack.svg"
    }
    ,
    {
      "label": "opencode",
      "match": ["opencode"],
      "icon": "opencode.svg"
    },
    {
      "label": "pi",
      "match": ["pi"],
      "icon": "pi-logo-light.svg",
      "iconDark": "pi-logo-dark.svg"
    },
    {
      "label": "Ollama",
      "match": ["ollama"],
      "icon": "ollama-light.png",
      "iconDark": "ollama-dark.png"
    }
  ]
