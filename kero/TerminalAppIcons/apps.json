{
  "version": 1,
  "apps": [
    {
      "label": "Claude",
      "match": ["claude"],
      "matchPrefix": ["claude-"],
      "material": "claude"
    },
    {
      "label": "Codex",
      "match": ["codex"],
      "matchPrefix": ["codex-"],
      "icon": "bxl-openai.svg"
    },
    {
      "label": "Grok",
      "match": ["grok"],
      "matchPrefix": ["grok-"],
      "icon": "bxl-grok.svg"
    },
    {
      "label": "Agy",
      "match": ["agy"],
      "matchPrefix": ["agy-"],
      "icon": "antigravity-color.png"
    },
    {
      "label": "Gemini",
      "match": ["gemini"],
      "material": "gemini-ai"
    },
    {
      "label": "Cursor",
      "match": ["cursor", "cursor-agent"],
      "material": "cursor"
    },
    {
      "label": "GitHub Copilot",
      "match": ["copilot"],
      "material": "copilot"
    },
    {
      "label": "Node.js",
      "match": ["node", "nodejs"],
      "material": "nodejs"
    },
    {
      "label": "npm",
      "match": ["npm", "npx"],
