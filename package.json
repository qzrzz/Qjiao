{
  "name": "Qjiao-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "debug": "bun run scripts/debug.ts",
    "version+": "bun run scripts/bump-version.ts && bun run scripts/update-changelog.ts",
    "release": "bun run scripts/release.ts",
    "appcast": "bun run scripts/generate-appcast.ts",
    "vendor:material-icons": "bun run scripts/vendor-material-icons.ts",
    "vendor:terminal-app-icons": "bun run scripts/vendor-terminal-app-icons.ts",
    "vendor:jxl": "bash scripts/vendor-jxl.sh",
    "web:dev": "qpage --dev ./web ./docs",
    "web:build": "qpage ./web ./docs",
    "web:preview": "qpage --preview ./web ./docs",
    "web:i18n:codex": "codex exec 根据./web/translate.md完成翻译任务",
    "web:i18n:gemini": "agy -p 根据./web/translate.md完成翻译任务",
    "web:publish": "bun run qzrzz-com up ./docs ./Qjiao",
    "web:build-publish": "bun run bun web:build && bun run web:publish"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "chalk": "6.0.0",
    "qpage": "link:qpage",
    "qrls": "link:qrls",
    "qzrzz-com": "link:qzrzz-com",
    "woff2": "^1.0.0"
  }
}
