{
  "name": "Qjiao-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "version+": "bun run scripts/bump-version.ts",
    "release": "bun run scripts/release.ts",
    "web:build": "cd ./web && npm run build",
    "web:update-latest": "cd ./web && bun run update-latest",
    "web:preview": "cd ./docs && vite preview ",
    "appcast": "bun run scripts/generate-appcast.ts",
    "vendor:material-icons": "bun run scripts/vendor-material-icons.ts",
    "vendor:terminal-app-icons": "bun run scripts/vendor-terminal-app-icons.ts",
    "vendor:jxl": "bash scripts/vendor-jxl.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "chalk": "6.0.0",
    "woff2": "^1.0.0"
  }
}
